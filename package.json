{
  "name": "nim-playground-provider",
  "version": "1.6.0",
  "author": "ChakornK <chakornk2007@gmail.com>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && bun test"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.0",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
