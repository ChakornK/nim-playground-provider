  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}