{
  "name": "nim-playground-provider",
  "version": "1.5.0",
  "author": "ChakornK <chakornk2007@gmail.com>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --experimental-strip-types --max-old-space-size=256 src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
